						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="24" y="-80" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="0.2" b="0.2" a="1" />
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="2" y="1" />
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
		</Frames>
	</Frame>
</Ui>

