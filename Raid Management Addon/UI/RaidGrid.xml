			<AbsDimension x="250" y="160" />
		</Size>
		<Anchors>
			<Anchor point="CENTER" />
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentTitleBG" file="Interface\PaperDollInfoFrame\UI-GearManager-Title-Background">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="8" y="-7" />
							</Offset>
						</Anchor>
						<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT">
							<Offset>
								<AbsDimension x="-8" y="-24" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentContentBG" file="Interface\PaperDollInfoFrame\UI-Character-CharacterTab-L1">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="8" y="-24" />
							</Offset>
						</Anchor>
						<Anchor point="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="-6" y="8" />
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.255" right="1" top="0.29" bottom="1" />
