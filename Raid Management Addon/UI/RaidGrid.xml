<Ui xmlns="http://www.blizzard.com/wow/ui/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<Frame name="RMARaidGridFrame" parent="UIParent" frameStrata="FULLSCREEN_DIALOG" toplevel="true" hidden="true" clampedToScreen="true" movable="true" enableMouse="true" registerForDrag="LeftButton">
