							<Offset>
								<AbsDimension x="5" y="1" />
							</Offset>
						</Anchor>
						<Anchor point="RIGHT" relativeTo="$parentTitleBG" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="-32" y="1" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
