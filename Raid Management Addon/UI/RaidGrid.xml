					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="22" y="-34" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentContextTitle" inherits="GameFontNormal">
