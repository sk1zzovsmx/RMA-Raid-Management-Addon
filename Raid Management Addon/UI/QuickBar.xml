						</Texture>
					</Layer>
				</Layers>
			</Button>
			<Button name="$parentHIS" inherits="RMAActionButtonTemplate">
				<Size><AbsDimension x="38" y="24" /></Size>
			</Button>
			<Button name="$parentSR" inherits="RMAActionButtonTemplate">
