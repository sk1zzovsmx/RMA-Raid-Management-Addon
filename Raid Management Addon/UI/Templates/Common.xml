<Ui xmlns="http://www.blizzard.com/wow/ui/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- Standard top-level window template -->
	<Frame name="RMAWindowTemplate" inherits="UIPanelDialogTemplate" parent="UIParent" movable="true" enableMouse="true" frameStrata="MEDIUM" toplevel="true" hidden="true" clampedToScreen="true" virtual="true">
		<Size>
			<AbsDimension x="230" y="385" />
		</Size>
		<Anchors>
			<Anchor point="CENTER" />
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString inherits="GameFontNormalSmall" name="$parentTitle" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentTitleBG" relativePoint="LEFT">
							<Offset>
								<AbsDimension x="5" y="1" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
	<!-- Compact dialog template -->
	<Frame name="RMADialogTemplate" parent="UIParent" movable="true" enableMouse="true" hidden="true" clampedToScreen="true" virtual="true">
		<Size>
			<AbsDimension x="230" y="385" />
		</Size>
		<Anchors>
			<Anchor point="CENTER" />
		</Anchors>
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<TileSize>
				<AbsValue val="8" />
			</TileSize>
			<EdgeSize>
				<AbsValue val="8" />
			</EdgeSize>
			<BackgroundInsets>
				<AbsInset top="1" right="1" bottom="1" left="1" />
			</BackgroundInsets>
		</Backdrop>
	</Frame>
	<!-- Standard action button template -->
	<Button name="RMAActionButtonTemplate" virtual="true">
		<Size>
			<AbsDimension x="25" y="25" />
		</Size>
		<NormalFont style="GameFontNormalSmall" />
		<DisabledFont style="GameFontDisableSmall" />
		<HighlightFont style="GameFontHighlightSmall" />
		<ButtonText name="$parentText">
			<Anchors>
				<Anchor point="LEFT">
					<Offset>
						<AbsDimension x="5" y="1" />
					</Offset>
				</Anchor>
				<Anchor point="RIGHT">
					<Offset>
						<AbsDimension x="-5" y="1" />
					</Offset>
				</Anchor>
			</Anchors>
		</ButtonText>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentLeft" file="Interface\Buttons\UI-Panel-Button-Up">
					<Size>
						<AbsDimension x="12" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT" />
						<Anchor point="BOTTOMLEFT" />
					</Anchors>
					<TexCoords left="0" right="0.09374" top="0" bottom="0.6875" />
				</Texture>
				<Texture name="$parentRight" file="Interface\Buttons\UI-Panel-Button-Up">
					<Size>
						<AbsDimension x="12" />
					</Size>
					<Anchors>
						<Anchor point="TOPRIGHT" />
						<Anchor point="BOTTOMRIGHT" />
					</Anchors>
					<TexCoords left="0.53125" right="0.625" top="0" bottom="0.6875" />
				</Texture>
				<Texture name="$parentMiddle" file="Interface\Buttons\UI-Panel-Button-Up">
					<Size>
						<AbsDimension x="12" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="12" y="0" />
							</Offset>
						</Anchor>
						<Anchor point="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="-12" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.09375" right="0.53125" top="0" bottom="0.6875" />
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture inherits="UIPanelButtonHighlightTexture" mod="ADD" />
		<PushedTexture file="Interface\Buttons\UI-Panel-Button-Down">
			<Anchors>
				<Anchor point="TOPLEFT" />
				<Anchor point="BOTTOMRIGHT" />
			</Anchors>
			<TexCoords left="0" right="0.625" top="0" bottom="0.6875" />
		</PushedTexture>
		<DisabledTexture inherits="UIPanelButtonDisabledTexture" />
	</Button>
	<!-- Selectable list row visual skeleton -->
	<Button name="RMASelectableRowButtonTemplate" virtual="true">
		<Layers>
			<Layer level="BORDER" textureSubLevel="-8">
				<Texture name="$parentSelectedTexture"
					file="Interface\QuestFrame\UI-QuestTitleHighlight"
					alphaMode="ADD"
					hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" />
						<Anchor point="BOTTOMRIGHT" />
					</Anchors>
					<Color r="0.20" g="0.60" b="1.00" a="0.52" />
				</Texture>
			</Layer>
			<Layer level="BORDER" textureSubLevel="-7">
				<Texture name="$parentFocusTexture"
					file="Interface\QuestFrame\UI-QuestTitleHighlight"
					alphaMode="ADD"
					hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" />
						<Anchor point="BOTTOMRIGHT" />
					</Anchors>
					<Color r="0.20" g="0.60" b="1.00" a="0.72" />
				</Texture>
			</Layer>
		</Layers>
		<PushedTexture name="$parentPushedTexture" file="Interface\Buttons\WHITE8x8">
			<Anchors>
				<Anchor point="TOPLEFT" />
				<Anchor point="BOTTOMRIGHT" />
			</Anchors>
			<Color r="1" g="1" b="1" a="0.08" />
		</PushedTexture>
	</Button>
	<Button name="RMARaidGridButtonTemplate" virtual="true">
		<Size>
			<AbsDimension x="150" y="28" />
		</Size>
		<PushedTexture file="Interface\Buttons\UI-SILVER-BUTTON-DOWN">
			<Anchors>
				<Anchor point="TOPLEFT" />
				<Anchor point="BOTTOMRIGHT" />
			</Anchors>
			<TexCoords left="0" right="0.625" top="0" bottom="0.8125" />
		</PushedTexture>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\Buttons\UI-SILVER-BUTTON-UP">
					<Anchors>
						<Anchor point="TOPLEFT" />
						<Anchor point="BOTTOMRIGHT" />
					</Anchors>
					<TexCoords left="0" right="0.625" top="0" bottom="0.8125" />
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentBg" file="Interface\Buttons\WHITE8x8" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" />
						<Anchor point="BOTTOMRIGHT" />
					</Anchors>
					<Color r="0" g="0" b="0" a="0.16" />
				</Texture>
				<Texture name="$parentTopLine" file="Interface\Buttons\WHITE8x8" hidden="true">
					<Size>
						<AbsDimension y="1" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT" />
						<Anchor point="TOPRIGHT" />
					</Anchors>
					<Color r="1" g="1" b="1" a="0.08" />
				</Texture>
				<Texture name="$parentBottomLine" file="Interface\Buttons\WHITE8x8" hidden="true">
					<Size>
						<AbsDimension y="1" />
					</Size>
					<Anchors>
						<Anchor point="BOTTOMLEFT" />
						<Anchor point="BOTTOMRIGHT" />
					</Anchors>
					<Color r="0" g="0" b="0" a="0.35" />
				</Texture>
				<Texture name="$parentSpecIcon" hidden="true">
					<Size>
						<AbsDimension x="16" y="16" />
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="12" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92" />
				</Texture>
				<FontString name="$parentText" inherits="GameFontNormalLarge" justifyH="CENTER" justifyV="MIDDLE">
					<Anchors>
						<Anchor point="CENTER">
							<Offset>
								<AbsDimension x="0" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<HighlightTexture name="$parentHighlight" file="Interface\Buttons\UI-Panel-Button-Highlight2" alphaMode="ADD">
			<Anchors>
				<Anchor point="TOPLEFT" />
				<Anchor point="BOTTOMRIGHT" />
			</Anchors>
			<TexCoords left="0" right="0.625" top="0" bottom="0.8125" />
		</HighlightTexture>
	</Button>
	<!-- Item icon button template -->
	<Button name="RMAItemIconButtonTemplate" virtual="true">
		<Size>
			<AbsDimension x="32" y="32" />
		</Size>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parentIconTexture">
					<Size>
						<AbsDimension x="32" y="32" />
					</Size>
					<Anchors>
						<Anchor point="CENTER" />
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<NormalTexture name="$parentNormalTexture" file="Interface\PaperDoll\UI-Backpack-EmptySlot">
			<Size>
				<AbsDimension x="32" y="32" />
			</Size>
			<Anchors>
				<Anchor point="CENTER" />
			</Anchors>
		</NormalTexture>
	</Button>
	<!-- General FontString template -->
	<FontString name="RMAFontString" font="GameFontNormal" justifyH="LEFT" justifyV="MIDDLE" virtual="true" />
	<!-- Gray FontString template -->
	<FontString name="RMAFontStringGray" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="MIDDLE" virtual="true">
		<Color r="0.5" g="0.5" b="0.5" a="1" />
	</FontString>
	<!-- List scrollframe template -->
	<ScrollFrame name="RMAListScrollFrameTemplate" inherits="UIPanelScrollFrameTemplate" virtual="true">
		<ScrollChild>
			<Frame name="$parentScrollChild">
				<Anchors>
					<Anchor point="TOPLEFT" />
					<Anchor point="TOPRIGHT" />
				</Anchors>
			</Frame>
		</ScrollChild>
	</ScrollFrame>
	<!-- Text scrollframe template -->
	<ScrollFrame name="RMATextScrollFrameTemplate" inherits="UIPanelScrollFrameTemplate" virtual="true" />
	<!-- Interface options scrollframe template -->
	<ScrollFrame name="RMAOptionsScrollFrameTemplate" inherits="UIPanelScrollFrameTemplate" virtual="true" />
	<!-- Text input template -->
	<EditBox name="RMATextInputTemplate" inherits="InputBoxTemplate" autoFocus="false" virtual="true">
		<FontString inherits="GameFontHighlight" />
	</EditBox>
	<!-- Numeric input template -->
	<EditBox name="RMANumericInputTemplate" inherits="RMATextInputTemplate" numeric="true" virtual="true" />
	<!-- Player Selection Button -->
	<Button name="RMASelectPlayerTemplate" inherits="RMASelectableRowButtonTemplate" virtual="true">
		<Size>
			<AbsDimension y="18" />
		</Size>
		<Anchors>
			<Anchor point="LEFT">
				<Offset>
					<AbsDimension x="5" y="0" />
				</Offset>
			</Anchor>
			<Anchor point="RIGHT">
				<Offset>
					<AbsDimension x="-5" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\AuctionFrame\UI-AuctionItemNameFrame">
					<Size>
						<AbsDimension x="10" y="20" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="0" y="2" />
							</Offset>
						</Anchor>
						<Anchor point="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="0" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords top="0" right="0.75" bottom="1.0" left="0.078125" />
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentSpecIcon" hidden="true">
					<Size>
						<AbsDimension x="12" y="12" />
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="2" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92" />
				</Texture>
				<FontString name="$parentRoll" inherits="GameFontNormalSmall" justifyH="RIGHT">
					<Size>
						<AbsDimension x="22" />
					</Size>
					<Anchors>
						<Anchor point="RIGHT">
							<Offset>
								<AbsDimension x="-4" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" a="1" />
				</FontString>
				<FontString name="$parentCounter" inherits="GameFontNormalSmall" justifyH="RIGHT">
					<Size>
						<AbsDimension x="30" />
					</Size>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parentRoll" relativePoint="LEFT">
							<Offset>
								<AbsDimension x="-2" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" a="1" />
				</FontString>
				<FontString name="$parentInfo" inherits="GameFontNormalSmall" justifyH="RIGHT">
					<Size>
						<AbsDimension x="22" />
					</Size>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parentCounter" relativePoint="LEFT">
							<Offset>
								<AbsDimension x="-2" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="0.82" b="0.36" a="1" />
				</FontString>
				<FontString name="$parentName" inherits="GameFontNormal" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="18" y="0" />
							</Offset>
						</Anchor>
						<Anchor point="RIGHT" relativeTo="$parentInfo" relativePoint="LEFT">
							<Offset>
								<AbsDimension x="-3" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" a="1" />
				</FontString>
				<Texture name="$parentStar" file="Interface\TARGETINGFRAME\UI-RaidTargetingIcon_1">
					<Size>
						<AbsDimension x="12" y="12" />
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativePoint="LEFT">
							<Offset>
								<AbsDimension x="2" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture>
			<Anchors>
				<Anchor point="TOPLEFT" />
				<Anchor point="BOTTOMRIGHT" />
			</Anchors>
			<Color r="1" g="0.8" b="0" a="0.1" />
		</HighlightTexture>
	</Button>
</Ui>

